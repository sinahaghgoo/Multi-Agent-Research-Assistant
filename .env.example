# Copy to .env and adjust. All variables are optional; defaults match config.py.

# --- Models (Ollama) ---
RA_OLLAMA_BASE_URL=http://localhost:11434
RA_CHAT_MODEL=qwen3.5:9b
RA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Lighter fallback chat model (faster, slightly weaker tool use):
# RA_CHAT_MODEL=qwen3:4b
RA_TEMPERATURE=0.2
RA_SEED=7
RA_NUM_CTX=16384

# --- Web access ---
# Set to false for a fully offline run (local corpus only).
RA_WEB_ENABLED=true
# ddgs backend: auto, duckduckgo, bing, brave, mojeek, google, ...
RA_SEARCH_BACKEND=auto
RA_SEARCH_REGION=us-en

# --- Budgets (stopping conditions) ---
RA_MAX_SUPERVISOR_TURNS=5
RA_MAX_WORKER_TOOL_CALLS=6
RA_MAX_SINGLE_AGENT_TOOL_CALLS=14
RA_MAX_FETCHES_PER_RUN=4
RA_RUN_TIMEOUT_S=900
